<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native-AOT smoke consumer for #220 (follow-up to #175). A tiny console app that
    references the library and exercises its public surface, published with PublishAot
    and executed in CI (see .github/workflows/aot-smoke.yaml). This gives a *runtime*
    AOT guarantee on top of the static IsAotCompatible analyzer gate (#175): it fails
    if AOT publish or execution ever breaks. Not part of the solution / not packed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Only while publishing. A PublishAot project restores a different package
         graph from a plain restore: the SDK pulls in the ILCompiler packs and
         resolves a runtime identifier, and that RID is the *host* one, so the graph
         reads `win-x64` on the Windows runners and `linux-x64;win-x64` on the Linux
         ones. No single committed lock file can satisfy both shapes, and enumerating
         every host RID would drag a per-RID ILCompiler runtime pack into every
         restore on every runner. Gating on _IsPublishing (set by the CLI for
         `dotnet publish`) keeps every ordinary restore RID-agnostic and identical
         across hosts; aot-smoke.yaml still publishes with PublishAot in force, and
         that one step opts out of locked mode. -->
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- Invariant globalization keeps the AOT binary small and avoids ICU; the app only
         emits ASCII diagnostics. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Pin NuGet dependencies by content hash: generate and maintain a committed
         packages.lock.json, and restore from it, failing when it is stale.
         Declared here rather than in Directory.Build.props because OSSF Scorecard's
         Pinned-Dependencies check reads RestoreLockedMode from *.csproj only (and
         Directory.Build.props is a protected file).
         CI-only, so local work is unaffected; after changing a PackageReference run
         `dotnet restore -p:RestoreForceEvaluate=true` and commit the updated lock file. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.D20.Dice\Wolfgang.D20.Dice.csproj" />
  </ItemGroup>

</Project>
