<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style since #387: the previous ToolsVersion 15 project mixed packages.config with
       PackageReference, and when built by the .NET SDK (as CI does) no package reference reached the
       compiler at all, so the example could not use Dice.TryParse (Wolfgang.TryPattern.Result<T>).
       As an SDK project it receives the library's package dependencies through the ProjectReference. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Example1_Console</RootNamespace>
    <AssemblyName>Example1-Console</AssemblyName>
    <!-- Mirrors a typical .NET Framework consumer: no nullable reference-type annotations. -->
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Wolfgang.D20.Dice\Wolfgang.D20.Dice.csproj" />
  </ItemGroup>

</Project>
